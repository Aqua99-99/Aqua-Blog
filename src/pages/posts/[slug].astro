---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getPosts } from "../../lib/posts";
import { formatDate } from "../../lib/dates";
import { withBase } from "../../lib/paths";

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description}>
  <article>
    <header class="page-head">
      <div class="mono">{formatDate(post.data.date)}</div>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
      <ul class="tags">
        {post.data.tags.map((tag) => <li><a href={withBase(`/tags/${tag}/`)}>#{tag}</a></li>)}
      </ul>
    </header>
    <div class="prose"><Content /></div>
    <a class="back" href={withBase("/posts/")}>글 목록으로 돌아가기</a>
  </article>
</Base>
