---
import Base from "../../layouts/Base.astro";
import { formatRange } from "../../lib/dates";
import { withBase } from "../../lib/paths";
import { getPortfolio } from "../../lib/portfolio";

export async function getStaticPaths() {
  const items = await getPortfolio();
  return items.filter((item) => item.bodyHtml !== "").map((item) => ({ params: { slug: item.slug }, props: { item } }));
}
const { item } = Astro.props;
const meta = [item.kind, formatRange(item.date), item.org].filter(Boolean).join(" · ");
---
<Base title={item.name} description={item.summary || undefined}>
  <article>
    <header class="page-head">
      <div class="mono">{meta}</div>
      <h1>{item.name}</h1>
      {item.summary && <p>{item.summary}</p>}
    </header>
    <div class="prose" set:html={item.bodyHtml} />
    {item.proofUrls.length > 0 && (
      <p class="prose">
        {item.proofUrls.map((url, i) => <a href={url}>{item.proofUrls.length > 1 ? `증빙 ${i + 1} ` : "증빙 보기"}</a>)}
      </p>
    )}
    <a class="back" href={withBase("/portfolio/")}>포트폴리오로 돌아가기</a>
  </article>
</Base>
