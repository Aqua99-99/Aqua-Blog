---
import Base from "../../layouts/Base.astro";
import ActivityTimeline from "../../components/ActivityTimeline.astro";
import CertTable from "../../components/CertTable.astro";
import ProjectCards from "../../components/ProjectCards.astro";
import { projects } from "../../data/site";
import { getPortfolio } from "../../lib/portfolio";

const items = await getPortfolio();
const credentials = items.filter((i) => i.kind !== "대외활동");
const activities = items.filter((i) => i.kind === "대외활동");
---
<Base title="포트폴리오" description="자격증과 수료 이력, 대외활동, 직접 만든 프로젝트를 모았습니다.">
  <header class="page-head">
    <h1>포트폴리오</h1>
    <p>자격증과 수료 이력, 대외활동, 직접 만든 프로젝트를 모았습니다.</p>
  </header>

  {credentials.length > 0 && (
    <section>
      <div class="section-head"><h2>자격증 · 수료</h2></div>
      <CertTable items={credentials} />
    </section>
  )}

  {activities.length > 0 && (
    <section class="section">
      <div class="section-head"><h2>대외활동</h2></div>
      <ActivityTimeline items={activities} />
    </section>
  )}

  <section class="section">
    <div class="section-head"><h2>프로젝트</h2></div>
    <ProjectCards projects={projects} />
  </section>
</Base>
